---
layout: base.njk
title: Industries | Aerospace, Semiconductor, Industrial Equipment
description: AMPINTEC PLUS metal 3D printing serves aerospace, semiconductor, mold & tooling, industrial equipment, and non-invasive medical device industries, offering prototyping, small-batch production, and part remanufacturing.
---
{% set i = i18n.en %}

<!-- DRAFT: the five industry blurbs are newly written copy pending 黃總 approval, see COPY_REVIEW.md -->
<section class="section section-dark" id="industries-hero">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{{ i.industriesPage.title }}</span>
      <h1 class="section-title">{{ i.industriesPage.title }}</h1>
      <!-- DRAFT: pending 黃總 review, see COPY_REVIEW.md -->
      <p class="section-subtitle">{{ i.industriesPage.answer_intro }}</p>
      <p class="section-subtitle">{{ i.industriesPage.intro }}</p>
    </div>

    <div class="apps-grid">
      <div class="app-card">
        <div class="app-icon">✈️</div>
        <h4>{{ i.industriesPage.aerospace_title }}</h4>
        <p>{{ i.industriesPage.aerospace_desc }}</p>
      </div>
      <div class="app-card">
        <div class="app-icon">💾</div>
        <h4>{{ i.industriesPage.semiconductor_title }}</h4>
        <p>{{ i.industriesPage.semiconductor_desc }}</p>
      </div>
      <div class="app-card">
        <div class="app-icon">🔧</div>
        <h4>{{ i.industriesPage.mold_title }}</h4>
        <p>{{ i.industriesPage.mold_desc }}</p>
      </div>
      <div class="app-card">
        <div class="app-icon">⚙️</div>
        <h4>{{ i.industriesPage.industrial_title }}</h4>
        <p>{{ i.industriesPage.industrial_desc }}</p>
      </div>
      <div class="app-card">
        <div class="app-icon">🏥</div>
        <h4>{{ i.industriesPage.medical_title }}</h4>
        <p>{{ i.industriesPage.medical_desc }}</p>
      </div>
    </div>
  </div>
</section>

<!-- DRAFT: Industry reference cases disclaimer and block, pending 黃總/legal review, see COPY_REVIEW.md -->
<section class="section section-light" id="industry-trends">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{{ i.industriesPage.trends_title }}</h2>
      <p class="section-subtitle">* {{ i.industriesPage.trends_disclaimer }}</p>
    </div>
    <div class="tech-categories">
      {%- for item in industryTrends.items %}
      <div class="category-card">
        <h4>{{ i.cases[item.key ~ '_title'] }}</h4>
        <p>{{ i.cases[item.key ~ '_desc'] }}</p>
        <p><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ i.cases.ref_label }}</a></p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section-dark" id="industries-cta">
  <div class="container home-cta-wrap">
    <h2 class="section-title">{{ i.home.cta_title }}</h2>
    <p>{{ i.contact.info_desc }}</p>
    <div class="hero-btns" style="justify-content:center; margin-top: 24px;">
      <a href="{{ ('/en/contact/') | url }}" class="btn btn-primary">{{ i.nav.cta }}</a>
    </div>
  </div>
</section>
