---
layout: base.njk
title: Frequently Asked Questions | Metal 3D Printing Services
description: Answers to common questions about AMPINTEC PLUS metal 3D printing contract manufacturing, including minimum order quantity, lead times, file formats, confidentiality, and small-batch custom production.
---
{% set i = i18n.en %}

<section class="section section-light" id="faq">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{{ i.nav.faq }}</span>
      <h1 class="section-title">{{ i.faq.title }}</h1>
    </div>

    <div class="faq-wrap">
      {%- for n in [1,2,3,4,5] %}
      <div class="faq-item">
        <div class="faq-question">{{ i.faq['q' ~ n] }}</div>
        <div class="faq-answer">
          <div class="faq-answer-content">{{ i.faq['a' ~ n] }}</div>
        </div>
      </div>
      {%- endfor %}
    </div>

    <!-- DRAFT: Q6-Q13 are newly proposed questions pending 黃總 review, see COPY_REVIEW.md.
         Not included in the FAQPage JSON-LD below until approved. -->
    <div class="section-header" style="margin-top: 60px;">
      <p class="section-subtitle">Draft — additional questions pending review</p>
    </div>
    <div class="faq-wrap">
      {%- for n in [6,7,8,9,10,11,12,13] %}
      <div class="faq-item">
        <div class="faq-question">{{ i.faq['q' ~ n] }}</div>
        <div class="faq-answer">
          <div class="faq-answer-content">{{ i.faq['a' ~ n] }}</div>
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section-dark" id="faq-cta">
  <div class="container home-cta-wrap">
    <h2 class="section-title">{{ i.home.cta_title }}</h2>
    <p>{{ i.contact.info_desc }}</p>
    <div class="hero-btns" style="justify-content:center; margin-top: 24px;">
      <a href="{{ ('/en/contact/') | url }}" class="btn btn-primary">{{ i.nav.cta }}</a>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for n in [1,2,3,4,5] %}
    {
      "@type": "Question",
      "name": "{{ i.faq['q' ~ n] | safe }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ i.faq['a' ~ n] | safe }}"
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
