---
layout: base.njk
title: Services Overview | Metal 3D Printing & One-Stop Post-Processing
description: AMPINTEC PLUS offers end-to-end contract manufacturing from design and prototyping, LPBF/SLM metal 3D printing, to one-stop post-processing, plus obsolete spare parts remanufacturing.
---
{% set i = i18n.en %}

<section class="section section-dark" id="services-hero">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{{ i.home.services_eyebrow }}</span>
      <h1 class="section-title">{{ i.home.services_title }}</h1>
      <!-- DRAFT: pending 黃總 review, see COPY_REVIEW.md -->
      <p class="section-subtitle">{{ i.servicesPage.overview_answer }}</p>
      <p class="section-subtitle">{{ i.servicesPage.overview_desc }}</p>
    </div>
  </div>
</section>

<!-- Three service cards -->
<section class="section section-dark" id="services-cards">
  <div class="container">
    <div class="services-overview-grid">
      <a href="{{ ('/en/services/lpbf-metal-3d-printing/') | url }}" class="service-card">
        <h3>{{ i.home.service_lpbf_title }}</h3>
        <p>{{ i.home.service_lpbf_desc }}</p>
        <span class="service-card-link">{{ i.home.services_cta }} →</span>
      </a>
      <a href="{{ ('/en/services/post-processing/') | url }}" class="service-card">
        <h3>{{ i.home.service_post_title }}</h3>
        <p>{{ i.home.service_post_desc }}</p>
        <span class="service-card-link">{{ i.home.services_cta }} →</span>
      </a>
      <a href="{{ ('/en/services/obsolete-spare-parts/') | url }}" class="service-card">
        <h3>{{ i.home.service_obsolete_title }}</h3>
        <p>{{ i.home.service_obsolete_desc }}</p>
        <span class="service-card-link">{{ i.home.services_cta }} →</span>
      </a>
    </div>
  </div>
</section>

<!-- One-stop workflow -->
<section class="section section-dark" id="technology">
  <div class="container">
    <h3 style="text-align:center;font-size:1.6rem;font-weight:800;margin-bottom:40px;color:var(--color-white);">{{ i.technology.flow_title }}</h3>
    <div class="tech-flow">
      <div class="flow-card">
        <span class="flow-num">01</span>
        <div class="flow-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
        </div>
        <h4>{{ i.technology.s1_title }}</h4>
        <p class="flow-desc">{{ i.technology.s1_desc }}</p>
      </div>
      <div class="flow-card">
        <span class="flow-num">02</span>
        <div class="flow-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
            <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
            <line x1="12" y1="22.08" x2="12" y2="12" />
          </svg>
        </div>
        <h4>{{ i.technology.s2_title }}</h4>
        <p class="flow-desc">{{ i.technology.s2_desc }}</p>
      </div>
      <div class="flow-card">
        <span class="flow-num">03</span>
        <div class="flow-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.21 15.89A10 10 0 1 1 8 2.83" />
            <path d="M22 12A10 10 0 0 0 12 2v10z" />
          </svg>
        </div>
        <h4>{{ i.technology.s3_title }}</h4>
        <p class="flow-desc">{{ i.technology.s3_desc }}</p>
      </div>
    </div>
  </div>
</section>

<!-- What else we can do -->
<section class="section section-dark" id="applications">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{{ i.applications.title }}</h2>
    </div>
    <div class="apps-grid">
      <div class="app-card">
        <div class="app-icon">💡</div>
        <h4>{{ i.applications.a1_title }}</h4>
        <p>{{ i.applications.a1_desc }}</p>
      </div>
      <div class="app-card">
        <div class="app-icon">⚡</div>
        <h4>{{ i.applications.a2_title }}</h4>
        <p>{{ i.applications.a2_desc }}</p>
      </div>
      <div class="app-card">
        <div class="app-icon">🔧</div>
        <h4>{{ i.applications.a3_title }}</h4>
        <p>{{ i.applications.a3_desc }}</p>
      </div>
      <div class="app-card">
        <div class="app-icon">📊</div>
        <h4>{{ i.applications.a4_title }}</h4>
        <p>{{ i.applications.a4_desc }}</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section-light" id="services-cta">
  <div class="container home-cta-wrap">
    <h2 class="section-title">{{ i.home.cta_title }}</h2>
    <p>{{ i.contact.info_desc }}</p>
    <div class="hero-btns" style="justify-content:center; margin-top: 24px;">
      <a href="{{ ('/en/contact/') | url }}" class="btn btn-primary">{{ i.nav.cta }}</a>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ i.home.services_title | safe }}",
  "description": "{{ i.servicesPage.overview_desc | safe }}",
  "provider": { "@id": "{{ site.siteUrl }}/#organization" }
}
</script>
